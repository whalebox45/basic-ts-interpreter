10 REM Comprehensive BASIC Test
20 REM Tests all major features
30 PRINT "=== COMPREHENSIVE BASIC TEST ==="
40 PRINT
100 REM === TEST 1: User-Defined Functions ===
110 PRINT "TEST 1: USER-DEFINED FUNCTIONS"
120 DEF FNA(X) = X * X
130 DEF FNB(X) = X * X * X
140 DEF FNC(X) = 2 * X + 1
150 LET N = 5
160 PRINT "N ="; N
170 PRINT "FNA(N) = N^2 ="; FNA(N)
180 PRINT "FNB(N) = N^3 ="; FNB(N)
190 PRINT "FNC(N) = 2*N+1 ="; FNC(N)
200 REM Test nested function calls
210 PRINT "FNA(3) + FNB(2) ="; FNA(3) + FNB(2)
220 PRINT
300 REM === TEST 2: Expressions and Precedence ===
310 PRINT "TEST 2: EXPRESSIONS AND PRECEDENCE"
