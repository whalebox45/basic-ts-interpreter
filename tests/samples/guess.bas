10 REM Guess the Number Game
20 RANDOMIZE
30 LET N = INT(RND * 100) + 1
40 LET C = 0
50 PRINT "I'M THINKING OF A NUMBER FROM 1 TO 100"
60 PRINT "WHAT IS YOUR GUESS";
70 INPUT G
80 LET C = C + 1
90 IF G = N THEN 150
100 IF G < N THEN 120
110 PRINT "TOO HIGH! TRY AGAIN"
115 GOTO 60
120 PRINT "TOO LOW! TRY AGAIN"
130 GOTO 60
150 PRINT "CORRECT! YOU GOT IT IN"; C; "TRIES!"
160 END
